<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.AIWeChat" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Primary brand color -->
        <item name="android:colorPrimary">@color/wechat_green</item>
        <item name="android:colorPrimaryDark">@color/wechat_green_dark</item>
        <item name="android:colorAccent">@color/wechat_green</item>
        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/wechat_green_dark</item>
        <!-- Background color -->
        <item name="android:colorBackground">@color/background</item>
    </style>

    <!-- WeChat style colors -->
    <color name="wechat_green">#07C160</color>
    <color name="wechat_green_dark">#06AD56</color>
    <color name="wechat_light_green">#E8F5E9</color>
    
    <!-- Background colors -->
    <color name="background">#F5F5F5</color>
    <color name="surface">#FFFFFF</color>
    <color name="card_background">#FFFFFF</color>
    
    <!-- Text colors -->
    <color name="text_primary">#191919</color>
    <color name="text_secondary">#7F7F7F</color>
    <color name="text_hint">#B2B2B2</color>
    
    <!-- Status colors -->
    <color name="success">#07C160</color>
    <color name="warning">#FF9800</color>
    <color name="error">#FF3B30</color>
    <color name="info">#007AFF</color>
    
    <!-- Chat colors -->
    <color name="chat_sent">#95EC69</color>
    <color name="chat_received">#FFFFFF</color>
    
    <!-- Divider -->
    <color name="divider">#E5E5E5</color>
</resources>
